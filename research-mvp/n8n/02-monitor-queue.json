{
  "name": "Fullmark · Monitorar fila",
  "nodes": [
    {
      "id": "d1a3d50a-789a-404b-af70-a7bb0c3274fc",
      "name": "A cada cinco minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },
    {
      "id": "f74c17dc-561e-4fc4-98d3-8b7be6fad3ae",
      "name": "Consultar fila",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        300,
        0
      ],
      "parameters": {
        "method": "GET",
        "url": "https://fullmark-research-api.onrender.com/internal/queue",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 70000
        }
      }
    },
    {
      "id": "f86e823c-0b08-426b-9e61-39a158fcc71e",
      "name": "Há tarefas que exigem atenção?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        600,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "leftValue": "={{ ($json.failed || 0) + ($json.needs_reconciliation || 0) }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        }
      }
    },
    {
      "id": "d56ac714-89c9-4ef8-bf44-a0796751a96a",
      "name": "Sinalizar falha operacional",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [
        900,
        -100
      ],
      "parameters": {
        "errorType": "errorMessage",
        "errorMessage": "Fullmark: há tarefas com falha ou execução Browser Use a reconciliar. Consulte o painel da pesquisa."
      }
    },
    {
      "id": "546f0c2f-9ac8-44ab-9cee-28d5d310dd94",
      "name": "Sticky Note 889ad7bc",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -50,
        -150
      ],
      "parameters": {
        "content": "## Fullmark / Monitoramento\nConfigurar URL da API e credencial Fullmark Internal (X-Internal-Token). Sem falhas, o fluxo termina sem notificação. Com falhas ou envio ambíguo, gera uma execução de erro visível no n8n. Configure um canal externo somente com destinatário autorizado.\nNão publicar antes da configuração segura da API.",
        "color": 4,
        "width": 1200,
        "height": 300
      }
    }
  ],
