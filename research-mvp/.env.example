ENVIRONMENT=development
DATABASE_URL=sqlite:///./fullmark.db
DEMO_MODE=false
# Em produção: postgresql+psycopg://... com sslmode=require, obtido no painel Supabase.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Alternative: private storage bridge keeps the Supabase service key inside Supabase.
STORAGE_PROXY_URL=
STORAGE_PROXY_TOKEN=
# Gerar no gerenciador de segredos: mínimo 32 caracteres aleatórios.
INTERNAL_TOKEN=
BROWSER_USE_API_KEY=
BROWSER_NETWORK_POLICY_ID=
BROWSER_MODEL=gpt-6-luna
BROWSER_MAX_COST_USD=25
NCBI_EMAIL=redacao@fullmark.com.br
NCBI_API_KEY=
LOCAL_STORAGE=./data

# Required in production: comma-separated verified reviewer emails.
ALLOWED_EMAILS=

# Proprietário explícito das entradas do ClickUp (UUID Supabase Auth)
AUTOMATION_OWNER_ID=

# Dispatcher residente em produção; n8n permanece como fallback.
WORKER_ENABLED=true
WORKER_CONCURRENCY=2
